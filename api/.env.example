# ===========================================
# Zica-Zima CRM — NestJS API
# Copy to .env and fill in real values:  cp .env.example .env
# ===========================================

# --- Required ---
NODE_ENV=development
# Use 4000 locally — Vite/Express already use 3000
PORT=4000

# Local Docker Postgres (api/docker-compose.yml) publishes 5433 on the host.
# Start it with:  npm run db:up
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zica_crm_dev?schema=public"

# --- Firebase Admin (Phase 2 auth) ---
# Download from Firebase Console → Project settings → Service accounts.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional (defaults shown) ---
# Comma-separated list of allowed browser origins. Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to false to disable the Swagger UI (recommended in production).
SWAGGER_ENABLED=true
