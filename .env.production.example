# ===========================================
# PRODUCTION — AWS EC2 (/home/ubuntu/Zica-Zima-CRM/.env)
# Copy to .env on the server. NEVER commit real .env to Git.
# Firebase Console → Project settings → Web app + Service accounts
# After editing: cp .env client/.env && npm run build && pm2 restart zica-crm
# ===========================================

# --- Client (Vite build — baked into dist at build time) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Server Firebase Admin (service account JSON) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional mirrors for server code paths
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# --- Other production services ---
GOOGLE_API_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=

NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://crm.zicazimapcmc.com

# --- AWS S3 file storage ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
