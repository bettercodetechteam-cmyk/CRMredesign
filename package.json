{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "dev:server": "cross-env NODE_ENV=development node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs server/index.ts",
    "dev:client": "vite",
    "dev:clean": "node -e \"const fs=require('fs');const path=require('path');function rm(p){if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('Removed:',p);}}rm(path.join('node_modules','.vite'));rm(path.join('client','node_modules','.vite'));\" && npm run dev",
    "build": "cross-env NODE_ENV=production vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --minify --outdir=dist",
    "build:client": "npx vite build --mode production",
    "deploy:sftp": "node scripts/deploy-hostinger-sftp.mjs",
    "deploy:hostinger": "node scripts/deploy-hostinger-sftp.mjs",
    "release:sftp": "node scripts/build-and-deploy-sftp.mjs",
    "build:check": "powershell -ExecutionPolicy Bypass -File ./build-with-env-check.ps1",
    "build:analyze": "cross-env NODE_ENV=production vite build --mode analyze",
    "preview": "vite preview",
    "prestart": "echo 'Deployment check completed'",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "clean:vite": "node -e \"const fs=require('fs');const path=require('path');function rm(p){if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('Removed:',p);}else{console.log('Not found:',p);}}rm(path.join('node_modules','.vite'));rm(path.join('client','node_modules','.vite'));\""
  },
