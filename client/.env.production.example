# ===========================================
# PRODUCTION Firebase — copy to client/.env on EC2 before build
# See also repo root .env.production.example (full server + client vars)
# ===========================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- NestJS CRM API (Phase 8 cutover; off by default) ---
VITE_USE_NEST_LEADS=false
VITE_USE_NEST_DASHBOARD=false
VITE_USE_NEST_FEES=false
