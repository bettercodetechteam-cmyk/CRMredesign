# ===========================================
# ZICA-ZIMA CRM — Environment Template
# For local dev: copy to .env (repo root) and client/.env, then fill in values.
# Vite loads: .env.example → .env → client/.env (later files win).
# NEVER commit real .env files with secrets.
# ===========================================

# --- Client (Vite — baked into dist at build time) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# API base URL (optional — defaults to same origin /api)
VITE_API_URL=

# NestJS feature flags (PostgreSQL CRM API — on by default)
VITE_CRM_STORAGE=postgres
VITE_USE_NEST_LEADS=true
VITE_USE_NEST_DASHBOARD=true
VITE_USE_NEST_FEES=true

# --- Server: PostgreSQL (primary CRM database) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/zica_crm_dev?schema=public

# --- Server: Firebase Admin (service account) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# --- Server: Google Maps / Firebase API key mirror ---
GOOGLE_API_KEY=

# --- Server: ImageKit ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Server: Email (password reset OTP) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=

# --- Server: SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Server: Runtime ---
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://crm.zicazimapcmc.com

# --- AWS S3 file storage ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
