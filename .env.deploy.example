# SFTP deploy credentials for Hostinger (copy to .env.deploy in project root)
# hPanel → Advanced → SSH Access

SFTP_HOST=your.server.ip.from.hpanel
SFTP_USER=u123456789
SFTP_PASSWORD=your-ssh-password
SFTP_PORT=65002
SFTP_REMOTE_PATH=domains/homeishome.in/public_html/

# GitHub Actions uses the same values as repository secrets:
# FTP_HOST, FTP_USER, FTP_PASSWORD
# Optional: SFTP_REMOTE_PATH
